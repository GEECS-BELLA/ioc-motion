diff --git a/aerotechApp/src/drvEnsembleAsyn.cc b/aerotechApp/src/drvEnsembleAsyn.cc
index 9e4d783..b69d5c7 100644
--- a/aerotechApp/src/drvEnsembleAsyn.cc
+++ b/aerotechApp/src/drvEnsembleAsyn.cc
@@ -211,6 +211,48 @@ the Ensemble parameters specified */
 #define ASCII_TIMEOUT_CHAR  '$'   /* AsciiCmdTimeoutChar */
 
 static motorEnsemble_t drv = {NULL, NULL, motorEnsembleLogMsg, 0, {0, 0}};
+
+/* ioc-motion's read-only-init patch. EnsembleInitWrites: 1 (upstream
+ * behaviour) probes the controller with the invalid command "NONE" and sends
+ * "RAMP MODE @n RATE" per axis and "WAIT MODE NOWAIT" from EnsembleAsynConfig;
+ * 0 probes with the query "PLANESTATUS(0)" (which the poller sends anyway) and
+ * sends the two mode commands before every motion command (move, jog, home)
+ * instead, so a boot and the idle poll send queries only. Both are idempotent;
+ * sending them each time also covers a controller restarted after the IOC.
+ * Set before EnsembleAsynConfig: var EnsembleInitWrites 0 */
+volatile int EnsembleInitWrites = 1;
+extern "C" {epicsExportAddress(int, EnsembleInitWrites);}
+
+/* With EnsembleInitWrites 0, the mode commands before a motion command. A
+ * motion command is not sent unless both are acknowledged: without WAIT MODE
+ * NOWAIT the ASCII interpreter blocks during the move (the driver's own
+ * comment) and the poll stops. Returns MOTOR_AXIS_OK or MOTOR_AXIS_ERROR. */
+static int sendMotionModes(AXIS_HDL pAxis)
+{
+    char inputBuff[BUFFER_SIZE], outputBuff[BUFFER_SIZE];
+    EnsembleController *pController = pAxis->pController;
+
+    inputBuff[0] = '\0';
+    if (EnsembleInitWrites)
+        return MOTOR_AXIS_OK;              /* sent at EnsembleAsynConfig, as upstream */
+    sprintf(outputBuff, "RAMP MODE @%d RATE", pAxis->axis);
+    if (sendAndReceive(pController, outputBuff, inputBuff, sizeof(inputBuff)) != asynSuccess ||
+        inputBuff[0] != ASCII_ACK_CHAR)
+    {
+        PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: %s not acknowledged (%s): motion command not sent\n",
+              outputBuff, inputBuff);
+        return MOTOR_AXIS_ERROR;
+    }
+    if (sendAndReceive(pController, (char *) "WAIT MODE NOWAIT", inputBuff, sizeof(inputBuff)) != asynSuccess ||
+        inputBuff[0] != ASCII_ACK_CHAR)
+    {
+        PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: WAIT MODE NOWAIT not acknowledged (%s): motion command not sent\n",
+              inputBuff);
+        return MOTOR_AXIS_ERROR;
+    }
+    return MOTOR_AXIS_OK;
+}
+
 static int numEnsembleControllers;
 /* Pointer to array of controller structures */
 static EnsembleController *pEnsembleController=NULL;
