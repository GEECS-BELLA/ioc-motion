 #define ASCII_TIMEOUT_CHAR  '$'   /* AsciiCmdTimeoutChar */
 
 static motorEnsemble_t drv = {NULL, NULL, motorEnsembleLogMsg, 0, {0, 0}};
+
+/* ioc-motion's read-only-init patch. EnsembleInitWrites: 1 (upstream
+ * behaviour) probes the controller with the invalid command "NONE" and sends
+ * "RAMP MODE @n RATE" per axis and "WAIT MODE NOWAIT" from EnsembleAsynConfig;
+ * 0 probes with the query "PLANESTATUS(0)" (which the poller sends anyway) and
+ * defers the two mode commands to the first motion command (move, jog, home)
+ * of the axis, so a boot and the idle poll send queries only.
+ * Set before EnsembleAsynConfig: var EnsembleInitWrites 0 */
+volatile int EnsembleInitWrites = 1;
+extern "C" {epicsExportAddress(int, EnsembleInitWrites);}
+
+/* The deferred mode commands, sent before the first motion command of an axis
+ * when EnsembleInitWrites is 0 (nothing pending otherwise). */
+static void sendDeferredModes(AXIS_HDL pAxis)
+{
+    char inputBuff[BUFFER_SIZE], outputBuff[BUFFER_SIZE];
+    EnsembleController *pController = pAxis->pController;
+
+    if (pAxis->rampModePending)
+    {
+        sprintf(outputBuff, "RAMP MODE @%d RATE", pAxis->axis);
+        if (sendAndReceive(pController, outputBuff, inputBuff, sizeof(inputBuff)) == asynSuccess)
+            pAxis->rampModePending = false;
+    }
+    if (pController->waitModePending)
+    {
+        if (sendAndReceive(pController, (char *) "WAIT MODE NOWAIT", inputBuff, sizeof(inputBuff)) == asynSuccess)
+            pController->waitModePending = false;
+    }
+}
