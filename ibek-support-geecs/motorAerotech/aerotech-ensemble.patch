+static const iocshArg ensembleAxisPowerArg2 = {"policy (leave|on_for_move|keep_on)", iocshArgString};
+static const iocshArg ensembleAxisPowerArg3 = {"on delay (s)", iocshArgDouble};
+static const iocshArg ensembleAxisPowerArg4 = {"off delay (s)", iocshArgDouble};
+static const iocshArg * const ensembleAxisPowerArgs[5] = {&ensembleAxisPowerArg0, &ensembleAxisPowerArg1,
+    &ensembleAxisPowerArg2, &ensembleAxisPowerArg3, &ensembleAxisPowerArg4};
+static const iocshFuncDef ensembleAxisPowerDef = {"EnsembleAxisPower", 5, ensembleAxisPowerArgs};
