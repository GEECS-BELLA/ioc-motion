@@ -211,6 +224,301 @@ the Ensemble parameters specified */
 #define ASCII_TIMEOUT_CHAR  '$'   /* AsciiCmdTimeoutChar */
 
 static motorEnsemble_t drv = {NULL, NULL, motorEnsembleLogMsg, 0, {0, 0}};
+
+/* ioc-motion's read-only-init patch. EnsembleInitWrites: 1 (upstream
+ * behaviour) probes the controller with the invalid command "NONE" and sends
+ * "RAMP MODE @n RATE" per axis and "WAIT MODE NOWAIT" from EnsembleAsynConfig;
+ * 0 probes with the query "PLANESTATUS(0)" (which the poller sends anyway) and
+ * sends the two mode commands before every motion command (move, jog, home)
+ * instead, so a boot and the idle poll send queries only. Both are idempotent;
+ * sending them each time also covers a controller restarted after the IOC.
+ * Set before EnsembleAsynConfig: var EnsembleInitWrites 0 */
+volatile int EnsembleInitWrites = 1;
+extern "C" {epicsExportAddress(int, EnsembleInitWrites);}
+
+/* With EnsembleInitWrites 0, the mode commands before a motion command. A
+ * motion command is not sent unless both are acknowledged: without WAIT MODE
+ * NOWAIT the ASCII interpreter blocks during the move (the driver's own
+ * comment) and the poll stops. Returns MOTOR_AXIS_OK or MOTOR_AXIS_ERROR. */
+static int sendMotionModes(AXIS_HDL pAxis)
+{
+    char inputBuff[BUFFER_SIZE], outputBuff[BUFFER_SIZE];
+    EnsembleController *pController = pAxis->pController;
+
+    inputBuff[0] = '\0';
+    if (EnsembleInitWrites)
+        return MOTOR_AXIS_OK;              /* sent at EnsembleAsynConfig, as upstream */
+    sprintf(outputBuff, "RAMP MODE @%d RATE", pAxis->axis);
+    if (sendAndReceive(pController, outputBuff, inputBuff, sizeof(inputBuff)) != asynSuccess ||
+        inputBuff[0] != ASCII_ACK_CHAR)
+    {
+        PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: %s not acknowledged (%s): motion command not sent\n",
+              outputBuff, inputBuff);
+        return MOTOR_AXIS_ERROR;
+    }
+    if (sendAndReceive(pController, (char *) "WAIT MODE NOWAIT", inputBuff, sizeof(inputBuff)) != asynSuccess ||
+        inputBuff[0] != ASCII_ACK_CHAR)
+    {
+        PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: WAIT MODE NOWAIT not acknowledged (%s): motion command not sent\n",
+              inputBuff);
+        return MOTOR_AXIS_ERROR;
+    }
+    return MOTOR_AXIS_OK;
+}
+
+/* ioc-motion's power-policy patch: a per-axis power policy, set by the iocsh
+ * command EnsembleAxisPower(card, axis, policy, onDelay, offDelay) after
+ * EnsembleAsynConfig. An axis with no such call is POWER_LEAVE: every path
+ * below returns before sending anything, and the driver is upstream's.
+ *   on_for_move  before a move, jog or home: ENABLE if the axis reads disabled
+ *                (acknowledged and then read enabled, or no motion command;
+ *                never FAULTACK), onDelay; after it: done is held at 0 until
+ *                offDelay after the end of motion, then DISABLE (acknowledged,
+ *                read disabled, and read disabled again by the next poll) and
+ *                only then done; otherwise, after POWER_OFF_TRIES, done with
+ *                PROBLEM (never done-and-disabled on a reply alone). A fault
+ *                during the motion is disabled at once, one try and no
+ *                confirming poll (PROBLEM ends the record's move anyway).
+ *                A CNEN put on a non-leave axis is read back from AXISSTATUS.
+ *   keep_on      the same ENABLE before motion; CNEN 0 is refused (nothing
+ *                sent, motorAxisProblem set); the driver never sends DISABLE.
+ * Boot and the idle poll are unchanged (queries only) under every policy. A
+ * refusal or failure sets powerError, shown as motorAxisProblem until the next
+ * accepted motion or CNEN put. Callers hold pAxis->mutexId. */
+#define POWER_LEAVE        0
+#define POWER_ON_FOR_MOVE  1
+#define POWER_KEEP_ON      2
+#define POWER_OFF_TRIES    3   /* DISABLE attempts (one per poll) before giving up with PROBLEM */
+#define POWER_POLL_FAILS  10   /* held polls with no clean AXISSTATUS before giving up with PROBLEM */
+
+static const char *powerPolicyName(int policy)
+{
+    return policy == POWER_ON_FOR_MOVE ? "on_for_move" : policy == POWER_KEEP_ON ? "keep_on" : "leave";
+}
+
+/* AXISSTATUS(@n): 1 enabled, 0 disabled, -1 no clean reply. */
+static int powerAxisEnabled(AXIS_HDL pAxis)
+{
+    char inputBuff[BUFFER_SIZE], outputBuff[BUFFER_SIZE];
+    Axis_Status st;
+
+    inputBuff[0] = '\0';
+    sprintf(outputBuff, "AXISSTATUS(@%d)", pAxis->axis);
+    if (sendAndReceive(pAxis->pController, outputBuff, inputBuff, sizeof(inputBuff)) != asynSuccess ||
+        inputBuff[0] != ASCII_ACK_CHAR || strlen(inputBuff) <= 1)
+        return -1;
+    st.All = atoi(&inputBuff[1]);
+    return st.Bits.axis_enabled ? 1 : 0;
+}
+
+/* DISABLE @n, then AXISSTATUS: 1 only if acknowledged and read disabled. */
+static int powerDisable(AXIS_HDL pAxis)
+{
+    char inputBuff[BUFFER_SIZE], outputBuff[BUFFER_SIZE];
+
+    inputBuff[0] = '\0';
+    sprintf(outputBuff, "DISABLE @%d", pAxis->axis);
+    if (sendAndReceive(pAxis->pController, outputBuff, inputBuff, sizeof(inputBuff)) != asynSuccess ||
+        inputBuff[0] != ASCII_ACK_CHAR)
+    {
+        PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: power policy: %s not acknowledged (%s)\n", outputBuff, inputBuff);
+        return 0;
+    }
+    if (powerAxisEnabled(pAxis) != 0)
+    {
+        PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: power policy: %s acknowledged, axis does not read disabled\n", outputBuff);
+        return 0;
+    }
+    return 1;
+}
+
+static void powerSetError(AXIS_HDL pAxis, int on)
+{
+    pAxis->powerError = on;
+    motorParam->setInteger(pAxis->params, motorAxisProblem, (on || pAxis->lastFault != 0) ? 1 : 0);
+    motorParam->callCallback(pAxis->params);
+}
+
+/* Before a motion command on an on_for_move or keep_on axis. MOTOR_AXIS_OK:
+ * the axis reads enabled (by this ENABLE or already), send the motion command. */
+static int powerBeforeMotion(AXIS_HDL pAxis)
+{
+    char inputBuff[BUFFER_SIZE], outputBuff[BUFFER_SIZE];
+    int enabled = powerAxisEnabled(pAxis);
+
+    if (enabled < 0)
+    {
+        PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: power policy %s: AXISSTATUS(@%d) not read: motion command not sent\n",
+              powerPolicyName(pAxis->powerPolicy), pAxis->axis);
+        powerSetError(pAxis, 1);
+        return MOTOR_AXIS_ERROR;
+    }
+    if (!enabled)
+    {
+        inputBuff[0] = '\0';
+        sprintf(outputBuff, "ENABLE @%d", pAxis->axis);
+        if (sendAndReceive(pAxis->pController, outputBuff, inputBuff, sizeof(inputBuff)) != asynSuccess ||
+            inputBuff[0] != ASCII_ACK_CHAR)
+        {
+            /* No FAULTACK here: clearing a fault stays an explicit act. */
+            PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: power policy %s: %s not acknowledged (%s): motion command not sent\n",
+                  powerPolicyName(pAxis->powerPolicy), outputBuff, inputBuff);
+            powerSetError(pAxis, 1);
+            return MOTOR_AXIS_ERROR;
+        }
+        if (pAxis->powerOnDelay > 0)
+            epicsThreadSleep(pAxis->powerOnDelay);
+        if (powerAxisEnabled(pAxis) != 1)
+        {
+            PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: power policy %s: %s acknowledged, axis does not read enabled: motion command not sent\n",
+                  powerPolicyName(pAxis->powerPolicy), outputBuff);
+            if (pAxis->powerPolicy == POWER_ON_FOR_MOVE)
+                powerDisable(pAxis);
+            powerSetError(pAxis, 1);
+            return MOTOR_AXIS_ERROR;
+        }
+    }
+    if (pAxis->powerError)
+        powerSetError(pAxis, 0);
+    return MOTOR_AXIS_OK;
+}
+
+/* After a motion command was tried (sent or refused) on an on_for_move axis:
+ * hold done at 0; the poller disables the axis offDelay after the end of
+ * motion and only then reports done. A command the controller refused has
+ * no motion, so its end is the next poll and the axis is disabled offDelay
+ * after it. */
+static void powerAfterMotion(AXIS_HDL pAxis)
+{
+    if (pAxis->powerPolicy != POWER_ON_FOR_MOVE)
+        return;
+    pAxis->powerHold = 1;
+    pAxis->powerOffArmed = 0;
+    pAxis->powerOffTries = 0;
+    pAxis->powerOffConfirm = 0;
+    pAxis->powerPollFails = 0;
+    motorParam->setInteger(pAxis->params, motorAxisDone, 0);
+    motorParam->callCallback(pAxis->params);
+    epicsEventSignal(pAxis->pController->pollEventId);
+}
+
+/* DISABLE not confirmed after POWER_OFF_TRIES: done, with PROBLEM (never done-and-disabled). */
+static bool powerGiveUp(AXIS_HDL pAxis)
+{
+    PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: power policy on_for_move: axis @%d not disabled after %d tries: done with PROBLEM; the axis may be enabled\n",
+          pAxis->axis, POWER_OFF_TRIES);
+    pAxis->powerHold = 0;
+    pAxis->powerOffArmed = 0;
+    pAxis->powerError = 1;
+    return false;
+}
+
+/* A held axis whose AXISSTATUS poll is not clean: after POWER_POLL_FAILS in a row,
+ * done with PROBLEM and CommError (an alarm, not a silent DMOV 0 forever). */
+static void powerPollFailed(AXIS_HDL pAxis)
+{
+    if (++pAxis->powerPollFails < POWER_POLL_FAILS)
+        return;
+    PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: power policy on_for_move: axis @%d status unreadable for %d polls while held\n",
+          pAxis->axis, POWER_POLL_FAILS);
+    pAxis->powerPollFails = 0;
+    pAxis->powerOffConfirm = 0;
+    powerGiveUp(pAxis);
+    motorParam->setInteger(pAxis->params, motorAxisCommError, 1);
+    motorParam->setInteger(pAxis->params, motorAxisProblem, 1);
+    motorParam->setInteger(pAxis->params, motorAxisDone, 1);
+    motorParam->callCallback(pAxis->params);
+}
+
+/* In the poller, for an axis with powerHold: true while done must stay 0. */
+static bool powerPoll(AXIS_HDL pAxis, bool move_active, Axis_Status *pStatus)
+{
+    epicsTimeStamp now;
+
+    if (pAxis->powerOffConfirm)
+    {   /* the poll after the DISABLE: its own AXISSTATUS must read disabled too */
+        pAxis->powerOffConfirm = 0;
+        if (!move_active && !pStatus->Bits.axis_enabled)
+        {
+            pAxis->powerHold = 0;
+            pAxis->powerOffArmed = 0;
+            return false;
+        }
+        PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: power policy on_for_move: axis @%d reads %s on the poll after DISABLE\n",
+              pAxis->axis, move_active ? "moving" : "enabled");
+        if (move_active)
+            pAxis->powerOffArmed = 0;
+        else if (++pAxis->powerOffTries >= POWER_OFF_TRIES)
+            return powerGiveUp(pAxis);
+        return true;
+    }
+    if (move_active || pStatus->Bits.homing_active)
+    {   /* (still, or again) moving, or a home cycle between its moves: the delay starts at the end */
+        pAxis->powerOffArmed = 0;
+        return true;
+    }
+    epicsTimeGetCurrent(&now);
+    if (!pAxis->powerOffArmed)
+    {
+        pAxis->powerOffArmed = 1;
+        pAxis->powerDoneTime = now;
+    }
+    if (epicsTimeDiffInSeconds(&now, &pAxis->powerDoneTime) < pAxis->powerOffDelay)
+        return true;
+    if (powerDisable(pAxis))
+    {
+        pAxis->powerOffConfirm = 1;        /* done on the next poll, if it reads disabled */
+        pStatus->Bits.axis_enabled = 0;    /* read after the DISABLE; the poll's own read was before it */
+        return true;
+    }
+    if (++pAxis->powerOffTries < POWER_OFF_TRIES)
+        return true;
+    return powerGiveUp(pAxis);
+}
+
+/* A STOP (motorAxisStop) on an on_for_move axis held for its DISABLE: true, and
+ * nothing is sent, only when the poller has seen the end of motion (armed for
+ * the DISABLE, or confirming it) and a fresh AXISSTATUS and PLANESTATUS(0) read
+ * no motion and no home cycle. The hold keeps DMOV 0, so the motor record still
+ * sees MOVN 1 and runs its new-target monitor (NTM): a feedback slide after the
+ * end of motion or the DISABLE beyond NTMF x (BDST + RDBD) against the commanded
+ * direction is a "wrong direction" to the record, which asks for a STOP; there
+ * is no motion to stop, and an ABORT is a command to a drive just disabled
+ * (U_CompAerotech, 2026-10-29: ABORT @0 30 ms after DISABLE @0, 3 of 5 moves).
+ * Any motion, any unclean reply, or any other policy or state: false, and the
+ * ABORT goes out as upstream. A fault or limit is the poller's to report, and
+ * is unchanged. */
+static bool powerStopNotNeeded(AXIS_HDL pAxis)
+{
+    char inputBuff[BUFFER_SIZE], outputBuff[BUFFER_SIZE];
+    Axis_Status st;
+    bool skip = false;
+
+    if (pAxis->powerPolicy != POWER_ON_FOR_MOVE)
+        return false;
+    epicsMutexLock(pAxis->mutexId);
+    if (pAxis->powerHold && (pAxis->powerOffArmed || pAxis->powerOffConfirm))
+    {
+        inputBuff[0] = '\0';
+        sprintf(outputBuff, "AXISSTATUS(@%d)", pAxis->axis);
+        if (sendAndReceive(pAxis->pController, outputBuff, inputBuff, sizeof(inputBuff)) == asynSuccess &&
+            inputBuff[0] == ASCII_ACK_CHAR && strlen(inputBuff) > 1)
+        {
+            st.All = atoi(&inputBuff[1]);
+            inputBuff[0] = '\0';
+            if (!st.Bits.move_active && !st.Bits.homing_active &&
+                sendAndReceive(pAxis->pController, (char *) "PLANESTATUS(0)", inputBuff, sizeof(inputBuff)) == asynSuccess &&
+                inputBuff[0] == ASCII_ACK_CHAR && strlen(inputBuff) > 1 && (atoi(&inputBuff[1]) & 0x01) == 0)
+                skip = true;
+        }
+    }
+    epicsMutexUnlock(pAxis->mutexId);
+    if (skip)
+        PRINT(pAxis->logParam, TERROR, "drvEnsembleAsyn: power policy on_for_move: STOP on axis @%d after its motion ended "
+              "(held for its DISABLE), no motion read: ABORT not sent\n", pAxis->axis);
+    return skip;
+}
