+/* ioc-motion's power-policy patch: EnsembleAxisPower(card, axis, policy,
+ * onDelay, offDelay), after EnsembleAsynConfig, before iocInit. axis is the
+ * driver axis (the record's ADDR). policy: leave (upstream), on_for_move,
+ * keep_on. onDelay 0..1 s (it sleeps in the controller's asyn port thread with
+ * the axis mutex held: every command queued to this controller, a STOP of
+ * another axis included, and the poll of this axis and those after it wait);
+ * offDelay, on_for_move only, at least the moving poll period (a shorter one
+ * can see the not-yet-started motion as its end). Sends nothing. Returns 0 or
+ * -1, and sets the iocsh error (an "on error halt" script stops there). */
+static int EnsembleAxisPower(int card, int axis, const char *policy, double onDelay, double offDelay)
+{
+    EnsembleController *pController;
+    AXIS_HDL pAxis;
+    int p;
+
+    if (card < 0 || card >= numEnsembleControllers || pEnsembleController[card].pAxis == NULL)
+    {
+        printf("EnsembleAxisPower: card %d not configured (EnsembleAsynConfig first)\n", card);
+        return -1;
+    }
+    pController = &pEnsembleController[card];
+    if (axis < 0 || axis >= pController->numAxes || pController->pAxis[axis].mutexId == NULL)
+    {
+        printf("EnsembleAxisPower: card %d has no driver axis %d\n", card, axis);
+        return -1;
+    }
+    pAxis = &pController->pAxis[axis];
+    if (interruptAccept)
+    {
+        printf("EnsembleAxisPower: refused after iocInit (the policy is a boot-time setting)\n");
+        return -1;
+    }
+    if (policy == NULL)
+        policy = "";
+    if (strcmp(policy, "leave") == 0)
+        p = POWER_LEAVE;
+    else if (strcmp(policy, "on_for_move") == 0)
+        p = POWER_ON_FOR_MOVE;
+    else if (strcmp(policy, "keep_on") == 0)
+        p = POWER_KEEP_ON;
+    else
+    {
+        printf("EnsembleAxisPower: policy \"%s\" is not leave, on_for_move or keep_on\n", policy);
+        return -1;
+    }
+    if (!(onDelay >= 0 && onDelay <= 1))
+    {
+        printf("EnsembleAxisPower: on delay %g s outside 0..1 s\n", onDelay);
+        return -1;
+    }
+    if (!(offDelay >= 0) || (p == POWER_ON_FOR_MOVE && offDelay < pController->movingPollPeriod))
+    {
+        printf("EnsembleAxisPower: off delay %g s: on_for_move needs at least the moving poll period, %g s\n",
+               offDelay, pController->movingPollPeriod);
+        return -1;
+    }
+    epicsMutexLock(pAxis->mutexId);
+    pAxis->powerPolicy = p;
+    pAxis->powerOnDelay = onDelay;
+    pAxis->powerOffDelay = offDelay;
+    epicsMutexUnlock(pAxis->mutexId);
+    printf("EnsembleAxisPower: card %d driver axis %d (Ensemble @%d): %s, on delay %g s, off delay %g s\n",
+           card, axis, pAxis->axis, powerPolicyName(p), onDelay, offDelay);
+    return 0;
+}
