+/** ioc-motion: with nf874xCheckMoves, the controller's error queue is read
+  * before a motion command (drainLateErrors) and after it (checkMoveError),
+  * TE? until 0, at most ten each, through the axis's controller prefix on a
+  * chain. Every code is charged to the axis it belongs to (chargeCode):
+  * - x14, MOTION IN PROGRESS, read after this axis's command: this axis (its
+  *   x names the channel that was moving, not the one commanded: 1>114 for a
+  *   1>2 command, U_BlueDiodePicos 2026-10-30);
+  * - any other channel code x01..x99: channel x's axis on this controller
+  *   (x08 arrives late, after the TE? that follows the move, so a code read
+  *   here may be another axis's or this axis's previous attempt's);
+  * - a general code (0-99) read after this axis's command: this axis; read
+  *   before it: logged only.
+  * A code charged to an axis latches its moveError_ (and lateOwn_ when it is
+  * read outside that axis's own post-command TE?, so that axis's next
+  * accepted command does not clear it); poll() shows the latch as the problem
+  * bit only once the axis reads done, so DMOV never goes to 1 mid-move. */
+void nf874xAxis::chargeCode(int ctl, int code, bool afterOwnCommand, bool *failsThis)
+{
+  int ch = code / 100;
+  int kind = code % 100;
+  nf874xAxis *owner = NULL;
+  if (ch == 0) {
+    owner = afterOwnCommand ? this : NULL;
+  } else if (kind == 14 && afterOwnCommand) {
+    owner = this;
+  } else if (ch >= 1 && ch <= 4) {
+    owner = pC_->getAxis(ctl ? (ctl - 1) * 4 + ch : ch);
+  }
+  asynPrint(pasynUser_, ASYN_TRACE_ERROR,
+      "%s: %s a command on %s: TE? %d, charged to %s\n", driverName,
+      afterOwnCommand ? "after" : "before", axisName_, code,
+      owner ? owner->axisName_ : "no axis (logged)");
+  if (!owner)
+    return;
+  owner->moveError_ = code;
+  if (owner == this && afterOwnCommand) {
+    if (failsThis) *failsThis = true;
+  } else {
+    owner->lateOwn_ = true;
+  }
+  if (owner != this)
+    owner->callParamCallbacks();
+}
+
+/** Read the queue to 0 (at most ten), charging each code. */
+asynStatus nf874xAxis::readQueue(bool afterOwnCommand, bool *failsThis)
+{
+  const char *gt = strchr(axisName_, '>');
+  int ctl = gt ? atoi(axisName_) : 0;
+  for (int i = 0; i < 10; i++) {
+    if (gt)
+      sprintf(pC_->outString_, "%d>TE?", ctl);
+    else
+      sprintf(pC_->outString_, "TE?");
+    memset(pC_->inString_, 0, sizeof(pC_->inString_));
+    asynStatus status = pC_->writeReadController();
+    if (status != asynSuccess)
+      return status;
+    const char *r = strchr(pC_->inString_, '>');
+    int code = atoi(r ? r + 1 : pC_->inString_);
+    if (code == 0)
+      return asynSuccess;
+    chargeCode(ctl, code, afterOwnCommand, failsThis);
+  }
+  return asynSuccess;
+}
+
+void nf874xAxis::drainLateErrors()
+{
+  if (!nf874xCheckMoves)
+    return;
+  readQueue(false, NULL);
+}
+
+asynStatus nf874xAxis::checkMoveError(const char *what)
+{
+  if (!nf874xCheckMoves)
+    return asynSuccess;
+  bool failed = false;
+  asynStatus status = readQueue(true, &failed);
+  bool keep = lateOwn_;
+  lateOwn_ = false;
+  if (status != asynSuccess) {
+    moveError_ = -1;
+    asynPrint(pasynUser_, ASYN_TRACE_ERROR,
+        "%s: axis %s: no reply to TE? after %s\n", driverName, axisName_, what);
+    return status;
+  }
+  if (failed) {
+    asynPrint(pasynUser_, ASYN_TRACE_ERROR,
+        "%s: axis %s: %s refused (TE? %d), latched until a later command is taken\n",
+        driverName, axisName_, what, moveError_);
+    return asynError;
+  }
+  // Taken. A code of this axis's own read outside its post-command TE? (an
+  // empty channel's late x08 from the previous attempt) keeps the latch
+  // through this command; otherwise the latch clears.
+  if (!keep)
+    moveError_ = 0;
+  return asynSuccess;
+}
+
+/** A refused command (home or jog switched off): latched like a refused move,
+  * so the record shows it (MAJOR) once the axis reads done. */
+void nf874xAxis::latchRefusal(int why)
+{
+  moveError_ = why;
+  lateOwn_ = false;
+}
