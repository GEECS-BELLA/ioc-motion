+# ioc-motion: one Picomotor channel of an 8742 (or of a controller on its
+# RS-485 chain) as a motor record on nf874xController (DTYP asynMotor), and
+# nothing else. Open loop: the position is the controller's step count (TP?),
+# so MRES 1 and EGU steps. RTRY 1 by default: the record compares TP? with
+# VAL after each move, and an 8742 ignores a move while any motor of that
+# controller runs (one motor at a time), so a dropped PA retries once and
+# then sets MISS; the move is absolute (UEIP 0), so a retry is idempotent.
+# RSTM Never, so the record never asks the driver to redefine the position
+# (DH) at init. DISP 1 refuses every put to the record's fields (dbPutField:
+# CA and dbpf) while the driver's status callbacks keep the readbacks live.
+record(motor, "$(P)$(M)")
+{
+	field(DESC, "$(DESC)")
+	field(DTYP, "asynMotor")
+	field(OUT,  "@asyn($(PORT),$(ADDR))")
+	field(DIR,  "$(DIR=Pos)")
+	field(VELO, "$(VELO)")
+	field(VBAS, "$(VBAS=0)")
+	field(VMAX, "$(VMAX=0)")
+	field(ACCL, "$(ACCL)")
+	field(BDST, "$(BDST=0)")
+	field(BVEL, "$(BVEL=0)")
+	field(BACC, "$(BACC=0.5)")
+	field(MRES, "$(MRES=1)")
+	field(PREC, "$(PREC=0)")
+	field(EGU,  "$(EGU=steps)")
+	field(DHLM, "$(DHLM)")
+	field(DLLM, "$(DLLM)")
+	field(RDBD, "$(RDBD=1)")
+	field(RTRY, "$(RTRY=1)")
+	field(DLY,  "$(DLY=0)")
+	field(RSTM, "Never")
+	field(TWV,  "$(TWV=10)")
+	field(DISP, "$(DISP=0)")
+}
