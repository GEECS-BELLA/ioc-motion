+/** ioc-motion: with nf874xCheckMoves, read the controller's error queue after
+  * a motion command (TE?, through the axis's controller prefix on a chain).
+  * A non-zero code fails the command and latches the problem bit until a
+  * later motion command is accepted. */
+asynStatus nf874xAxis::checkMoveError(const char *what)
+{
+  if (!nf874xCheckMoves)
+    return asynSuccess;
+  const char *gt = strchr(axisName_, '>');
+  if (gt)
+    sprintf(pC_->outString_, "%.*sTE?", (int)(gt - axisName_ + 1), axisName_);
+  else
+    sprintf(pC_->outString_, "TE?");
+  memset(pC_->inString_, 0, sizeof(pC_->inString_));
+  asynStatus status = pC_->writeReadController();
+  if (status != asynSuccess) {
+    moveError_ = -1;
+    asynPrint(pasynUser_, ASYN_TRACE_ERROR,
+        "%s: axis %s: no reply to TE? after %s\n", driverName, axisName_, what);
+    return status;
+  }
+  const char *reply = strchr(pC_->inString_, '>');
+  int code = atoi(reply ? reply + 1 : pC_->inString_);
+  if (code != 0) {
+    moveError_ = code;
+    asynPrint(pasynUser_, ASYN_TRACE_ERROR,
+        "%s: axis %s: %s refused, TE? %d (problem bit latched)\n",
+        driverName, axisName_, what, code);
+    // The queue holds one entry per error and TE? reads one: a move and its
+    // retry refused leave a second code that the next axis's TE? would read
+    // as its own (U_BlueDiodePicos, 2026-10-30: m5's second 2>108 flagged
+    // m6's first move). Read the rest now, at most nine more.
+    for (int i = 0; i < 9; i++) {
+      memset(pC_->inString_, 0, sizeof(pC_->inString_));
+      if (pC_->writeReadController() != asynSuccess) break;
+      const char *more = strchr(pC_->inString_, '>');
+      int next = atoi(more ? more + 1 : pC_->inString_);
+      if (next == 0) break;
+      asynPrint(pasynUser_, ASYN_TRACE_ERROR,
+          "%s: axis %s: also queued: TE? %d\n", driverName, axisName_, next);
+    }
+    setIntegerParam(pC_->motorStatusProblem_, 1);
+    callParamCallbacks();
+    return asynError;
+  }
+  // Accepted: clear the latch and the bit now, before the base class's
+  // callback with Done 0, or the record would read the old problem bit as
+  // "done" mid-move and retry into x14.
+  moveError_ = 0;
+  setIntegerParam(pC_->motorStatusProblem_, 0);
+  return asynSuccess;
+}
