         driverName, functionName, comStatus);
   }
   
-  setIntegerParam(pC_->motorStatusProblem_, comStatus ? 1 : 0);
+  setIntegerParam(pC_->motorStatusProblem_, (comStatus || moveError_) ? 1 : 0);
   callParamCallbacks();
