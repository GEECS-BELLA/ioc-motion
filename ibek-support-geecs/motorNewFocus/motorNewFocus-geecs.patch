diff --git a/newFocusApp/Db/NF874xMotor.db b/newFocusApp/Db/NF874xMotor.db
new file mode 100644
index 0000000..6b9c850
--- /dev/null
+++ b/newFocusApp/Db/NF874xMotor.db
@@ -0,0 +1,32 @@
+# ioc-motion: one Picomotor channel of an 8742 (or of a controller on its
+# RS-485 chain) as a motor record on nf874xController (DTYP asynMotor), and
+# nothing else. Open loop: the position is the controller's step count (TP?),
+# so MRES 1 and EGU steps; RTRY 0 (no encoder: the record would compare the
+# count with itself); RSTM Never, so the record never asks the driver to
+# redefine the position (DH) at init. DISP 1 refuses every put to the record's
+# fields (dbPutField: CA and dbpf) while the driver's status callbacks keep the
+# readbacks live.
+record(motor, "$(P)$(M)")
+{
+	field(DESC, "$(DESC)")
+	field(DTYP, "asynMotor")
+	field(OUT,  "@asyn($(PORT),$(ADDR))")
+	field(DIR,  "$(DIR=Pos)")
+	field(VELO, "$(VELO)")
+	field(VBAS, "$(VBAS=0)")
+	field(VMAX, "$(VMAX=0)")
+	field(ACCL, "$(ACCL)")
+	field(BDST, "$(BDST=0)")
+	field(BVEL, "$(BVEL=0)")
+	field(BACC, "$(BACC=0.5)")
+	field(MRES, "$(MRES=1)")
+	field(PREC, "$(PREC=0)")
+	field(EGU,  "$(EGU=steps)")
+	field(DHLM, "$(DHLM)")
+	field(DLLM, "$(DLLM)")
+	field(RDBD, "$(RDBD=1)")
+	field(RTRY, "0")
+	field(RSTM, "Never")
+	field(TWV,  "$(TWV=10)")
+	field(DISP, "$(DISP=0)")
+}
diff --git a/newFocusApp/src/874xMotorDriver.cpp b/newFocusApp/src/874xMotorDriver.cpp
index ec63c07..510aa41 100644
--- a/newFocusApp/src/874xMotorDriver.cpp
+++ b/newFocusApp/src/874xMotorDriver.cpp
@@ -27,6 +27,21 @@ March 4, 2011
 #include <epicsExport.h>
 #include "874xMotorDriver.h"
 
+/* ioc-motion: two switches, 1 = upstream behaviour. Set before iocInit.
+ * nf874xSetLimits: 1 (upstream) sends "<axis> SR <v>" / "<axis> SL <v>" from
+ *   setHighLimit()/setLowLimit(), which the motor record calls for every axis
+ *   at record init (its DHLM/DLLM) and on every DHLM/DLLM change; 0 keeps the
+ *   value in the driver and sends nothing (the record enforces its own limits;
+ *   SR/SL are 8743-CL closed-loop commands, absent from an 8742).
+ * nf874xHomeAllowed: 1 (upstream) sends AC, VA and "<axis> MT +/-" or
+ *   "<axis> MZ +/-" for HOMF/HOMR (8743-CL commands; an open-loop Picomotor
+ *   has no home or limit switch); 0 refuses the home with an error and sends
+ *   nothing. Both are global to the IOC. */
+volatile int nf874xSetLimits = 1;
+extern "C" {epicsExportAddress(int, nf874xSetLimits);}
+volatile int nf874xHomeAllowed = 1;
+extern "C" {epicsExportAddress(int, nf874xHomeAllowed);}
+
 #define NUM_nf874x_PARAMS 3
 
 static const char *driverName = "nf874xMotorDriver";
@@ -70,9 +85,18 @@ nf874xController::nf874xController(const char *portName, const char *nf874xPortN
   // Set default control mode (open, closed) based on model
   sprintf(this->outString_, "VE?");
   this->writeReadController();
-  strncpy(modelName_, this->inString_, 9);
-  char *spc = strchr(modelName_, ' ');
-  *spc = '\0';
+  // ioc-motion: upstream copied 9 characters without a terminator and wrote
+  // through strchr()'s result, a NULL dereference whenever no space falls in
+  // the copy (an empty reply after a timeout, or an identity such as
+  // "New_Focus 8742 ..."). The model is now found anywhere in the reply.
+  memset(modelName_, 0, sizeof(modelName_));
+  if (strstr(this->inString_, "8743-CL"))
+    strcpy(modelName_, "8743-CL");
+  else if (strstr(this->inString_, "8742"))
+    strcpy(modelName_, "8742");
+  asynPrint(this->pasynUserSelf, ASYN_TRACE_ERROR,
+      "%s:%s: VE? answered \"%s\": model %s\n",
+      driverName, functionName, this->inString_, modelName_[0] ? modelName_ : "unknown");
   
   if(strcmp(modelName_, "8743-CL") == 0)
     hasClosedLoopSupport_ = true;
@@ -240,6 +264,12 @@ nf874xAxis::nf874xAxis(nf874xController *pC, int axisNo)
   : asynMotorAxis(pC, axisNo),
     pC_(pC)
 {
+  // ioc-motion: upstream set these on an 8743-CL only, so an 8742's home()
+  // read an uninitialized limitChecking_.
+  lastDirection_ = 0;
+  encoderPosition_ = 0.0;
+  limitChecking_ = 0;
+  highLimit_ = lowLimit_ = 0.0;
   // For daisy-chained controllers, assuming k axes per controller, and controllers number (1, 2, ...)
   // 8742 has 4 axes per controller; 8743 with closed-loop support only has 2.
   // Note that axis 1>3 addresses the same motor as bare 3, but response strings will be prefixed with 1>.
@@ -324,6 +354,13 @@ asynStatus nf874xAxis::move(double position, int relative, double minVelocity,
 asynStatus nf874xAxis::home(double minVelocity, double maxVelocity, double acceleration, int forwards)
 {
   asynStatus status;
+
+  if (!nf874xHomeAllowed) {
+    asynPrint(pasynUser_, ASYN_TRACE_ERROR,
+        "%s: home refused on axis %s (nf874xHomeAllowed 0): nothing sent\n",
+        driverName, axisName_);
+    return asynError;
+  }
   
   sprintf(pC_->outString_, "%s AC %f", axisName_, acceleration);
   status = pC_->writeController();
@@ -444,9 +481,11 @@ asynStatus nf874xAxis::doMoveToHome()
 asynStatus nf874xAxis::setHighLimit(double highLimit) {
   asynStatus status;
 
+  highLimit_ = highLimit;
+  if (!nf874xSetLimits)
+    return asynSuccess;
   sprintf(pC_->outString_, "%s SR %f", axisName_, highLimit);
   status = pC_->writeController();
-  highLimit_ = highLimit;
   return status;
 }
 
@@ -456,9 +495,11 @@ asynStatus nf874xAxis::setHighLimit(double highLimit) {
 asynStatus nf874xAxis::setLowLimit(double lowLimit) {
   asynStatus status;
 
+  lowLimit_ = lowLimit;
+  if (!nf874xSetLimits)
+    return asynSuccess;
   sprintf(pC_->outString_, "%s SL %f", axisName_, lowLimit);
   status = pC_->writeController();
-  lowLimit_ = lowLimit;
   return status;
 }
 
