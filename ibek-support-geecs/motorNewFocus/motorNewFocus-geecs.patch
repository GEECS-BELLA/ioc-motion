+/* ioc-motion: two switches, 1 = upstream behaviour. Set before iocInit.
+ * nf874xSetLimits: 1 (upstream) sends "<axis> SR <v>" / "<axis> SL <v>" from
+ *   setHighLimit()/setLowLimit(), which the motor record calls for every axis
+ *   at record init (its DHLM/DLLM) and on every DHLM/DLLM change; 0 keeps the
+ *   value in the driver and sends nothing (the record enforces its own limits;
+ *   SR/SL are 8743-CL closed-loop commands, absent from an 8742).
+ * nf874xHomeAllowed: 1 (upstream) sends AC, VA and "<axis> MT +/-" or
+ *   "<axis> MZ +/-" for HOMF/HOMR (8743-CL commands; an open-loop Picomotor
+ *   has no home or limit switch); 0 refuses the home with an error and sends
+ *   nothing.
+ * nf874xJogAllowed: 1 (upstream) sends AC, VA and "<axis> MV +/-" for
+ *   JOGF/JOGR, which runs until ST: an open-loop Picomotor has no switch to
+ *   end it, and a lost link leaves it running; 0 refuses the jog with an
+ *   error and sends nothing.
+ * nf874xCheckMoves: 0 (upstream) never reads the error queue, so a move the
+ *   controller ignores ("x14, MOTION IN PROGRESS": an 8742 drives one motor
+ *   at a time, manual 90066734D 3.5.5 and 6.2.1 PA/PR/MV; a refused
+ *   argument) completes in the record at the old position with no alarm;
+ *   1 drains the queue at creation (TE? until 0, at most 10) and sends TE?
+ *   after every motion command: a non-zero code fails the command and
+ *   latches the axis's problem bit (MSTA, a MAJOR STATE alarm on the
+ *   record) until a later motion command is accepted. Queries only.
+ * All four are global to the IOC. */
+volatile int nf874xSetLimits = 1;
+extern "C" {epicsExportAddress(int, nf874xSetLimits);}
+volatile int nf874xHomeAllowed = 1;
+extern "C" {epicsExportAddress(int, nf874xHomeAllowed);}
+volatile int nf874xJogAllowed = 1;
+extern "C" {epicsExportAddress(int, nf874xJogAllowed);}
+volatile int nf874xCheckMoves = 0;
+extern "C" {epicsExportAddress(int, nf874xCheckMoves);}
+
