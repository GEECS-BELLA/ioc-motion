+        memset(this->inString_, 0, sizeof(this->inString_));
+        if (this->writeReadController() != asynSuccess) break;
+        const char *gt = strchr(this->inString_, '>');
+        if (atoi(gt ? gt + 1 : this->inString_) == 0) break;
+        asynPrint(this->pasynUserSelf, ASYN_TRACE_ERROR,
+            "%s:%s: error queued before start: %s\n", driverName, functionName, this->inString_);
+      }
+    }
+  }
   if(strcmp(modelName_, "8743-CL") == 0)
     hasClosedLoopSupport_ = true;
   else
@@ -240,6 +306,14 @@ nf874xAxis::nf874xAxis(nf874xController *pC, int axisNo)
