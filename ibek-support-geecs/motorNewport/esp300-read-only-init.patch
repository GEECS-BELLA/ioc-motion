   #ifdef DEBUG
     if (level < drvESP300debug) {
@@ -726,12 +732,38 @@ errexit:
             //    total_axis = 4;
             //}
 
+            if (!ESP300InitStop)
+            {
+                /* Drain the controller's error FIFO (10 deep; TB? pops one per
+                 * read) so an error left by an earlier client cannot end the
+                 * axis count below at axis 1. */
+                int drain;
+                for (drain = 0; drain < 10; drain++)
+                {
+                    send_mess(card_index, "TB?", 0);
+                    recv_mess(card_index, buff, 1);
+                    if (atoi(buff) == 0)
+                        break;
+                }
+            }
+
             // Stop all motors, checking for "Axis number out of range" to determine
             // the number of axes on the device.
             for (motor_index = 0; motor_index < ESP300_MAX_AXIS; motor_index++)
             {
-                sprintf(buff, STOP_AXIS, motor_index + 1);  /* Stop motor */
-                send_mess(card_index, buff, 0);
+                if (ESP300InitStop)
+                {
+                    sprintf(buff, STOP_AXIS, motor_index + 1);  /* Stop motor */
+                    send_mess(card_index, buff, 0);
+                }
+                else
+                {
+                    /* Query instead of stop: an axis out of range answers
