-    if (msgptr[last] == ';')
-    msgptr[last] = (char) NULL;
+    last = strlen(msgptr);
+    if (last > 0 && msgptr[last - 1] == ';')  /* an empty transaction has no last byte */
+        msgptr[last - 1] = (char) NULL;
 
     return(motor_end_trans_com(mr, drvtabptr));
 }
