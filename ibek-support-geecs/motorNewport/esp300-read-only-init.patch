+/* ESP300SetLimits: 1 (upstream behaviour) pushes the motor record's DHLM/DLLM
+ * into the controller's software travel limits (SR/SL) at record init and on
+ * every limit change; 0 leaves the controller's limits untouched and the
+ * record enforces its own. Set before iocInit: var ESP300SetLimits 0 */
+volatile int ESP300SetLimits = 1;
+extern "C" {epicsExportAddress(int, ESP300SetLimits);}
+
 static struct board_stat **ESP300_cards;
 
 /* --------------------------- program data --------------------- */
@@ -280,10 +287,12 @@ static RTN_STATUS ESP300_build_trans(motor_cmnd command, double *parms, struct m
 	    sprintf(buff, "%.2dMF;", axis);
 	    break;
 	case SET_HIGH_LIMIT:
-	    sprintf(buff, "%.2dSR%f;", axis, cntrl_units);
+	    if (ESP300SetLimits)
+		sprintf(buff, "%.2dSR%f;", axis, cntrl_units);
 	    break;
 	case SET_LOW_LIMIT:
-	    sprintf(buff, "%.2dSL%f;", axis, cntrl_units);
+	    if (ESP300SetLimits)
+		sprintf(buff, "%.2dSL%f;", axis, cntrl_units);
 	    break;
 	default:
 	    rtnval = ERROR;
diff --git a/newportApp/src/drvESP300.cc b/newportApp/src/drvESP300.cc
index cfa6ce3..41a8c14 100644
--- a/newportApp/src/drvESP300.cc
+++ b/newportApp/src/drvESP300.cc
@@ -79,6 +79,12 @@ USAGE...    Motor record driver level support for Newport ESP300/100.
 
 volatile int drvESP300debug = 0;
 extern "C" {epicsExportAddress(int, drvESP300debug);}
+/* ESP300InitStop: 1 (upstream behaviour) counts the controller's axes at
+ * init by sending each a Stop (ST) until the controller answers "axis number
+ * out of range"; 0 probes with a query (MO?) instead, so initialisation
+ * writes nothing to the controller. Set before iocInit: var ESP300InitStop 0 */
+volatile int ESP300InitStop = 1;
+extern "C" {epicsExportAddress(int, ESP300InitStop);}
 static inline void Debug(int level, const char *format, ...) {
   #ifdef DEBUG
     if (level < drvESP300debug) {
@@ -730,8 +736,19 @@ errexit:
             // the number of axes on the device.
             for (motor_index = 0; motor_index < ESP300_MAX_AXIS; motor_index++)
             {
-                sprintf(buff, STOP_AXIS, motor_index + 1);  /* Stop motor */
-                send_mess(card_index, buff, 0);
+                if (ESP300InitStop)
+                {
+                    sprintf(buff, STOP_AXIS, motor_index + 1);  /* Stop motor */
+                    send_mess(card_index, buff, 0);
+                }
+                else
+                {
+                    /* Query instead of stop: an axis out of range answers
+                     * nothing (read times out) and sets error 9, as ST does. */
+                    sprintf(buff, "%.2dMO?", motor_index + 1);
+                    send_mess(card_index, buff, 0);
+                    recv_mess(card_index, buff, 1);
+                }
                 // Check for axis number out of range.
                 send_mess(card_index, "TB?", 0);
                 recv_mess(card_index, buff, 1);
