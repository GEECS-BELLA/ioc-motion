new file mode 100644
index 0000000..acb5e82
--- /dev/null
+++ b/newportApp/Db/SMC100Motor.db
@@ -0,0 +1,33 @@
+# ioc-motion: one SMC100 axis (one controller address on the RS-485 chain) as a
+# motor record on SMC100Driver (DTYP asynMotor), and nothing else: no auxiliary
+# records with links into the driver. RSTM defaults to Never, so the record never
+# asks the driver to redefine the position at init (devMotorAsyn's
+# init_controller does for RSTM Always, or NearZero/Conditional with a non-zero
+# DVAL after an autosave restore; the SMC100 has no such command). RTRY 0: the
+# controller positions itself, the record does not retry. DISP 1 refuses every
+# put to the record's fields (dbPutField: CA and dbpf) without stopping the
+# driver's status callbacks, so readbacks stay live.
+record(motor, "$(P)$(M)")
+{
+	field(DESC, "$(DESC)")
+	field(DTYP, "asynMotor")
+	field(OUT,  "@asyn($(PORT),$(ADDR))")
+	field(DIR,  "$(DIR)")
+	field(VELO, "$(VELO)")
+	field(VBAS, "$(VBAS)")
+	field(VMAX, "$(VMAX=0)")
+	field(ACCL, "$(ACCL)")
+	field(BDST, "$(BDST)")
+	field(BVEL, "$(BVEL)")
+	field(BACC, "$(BACC)")
+	field(MRES, "$(MRES)")
+	field(PREC, "$(PREC)")
+	field(EGU,  "$(EGU)")
+	field(DHLM, "$(DHLM)")
+	field(DLLM, "$(DLLM)")
+	field(RDBD, "$(RDBD=0)")
+	field(RTRY, "$(RTRY=0)")
+	field(RSTM, "$(RSTM=Never)")
+	field(TWV,  "$(TWV=1)")
+	field(DISP, "$(DISP=0)")
+}
