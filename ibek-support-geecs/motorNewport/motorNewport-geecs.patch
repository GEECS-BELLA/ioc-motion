+/* ioc-motion: two switches, 1 = upstream behaviour. Set before iocInit.
+ * SMC100SetterResend: 1 (upstream) lets setPosition() and setClosedLoop() call
+ *   writeReadController() without writing a command of their own, so they resend
+ *   whatever is left in outString_ (the last PA/PR move, VA, AC, TP or TS); 0
+ *   sends nothing and returns asynError (the SMC100 cannot redefine its position).
+ * SMC100StatusUpstream: 1 (upstream) reads TP and TS at fixed character
+ *   positions (a one-digit address), MOVING (28) only as moving and the
+ *   end-of-run digit by equality; 0 parses each reply after its command name
+ *   (addresses 1-31), counts HOMING and JOGGING (46, 47) as moving, reads every error
+ *   bit, sets Homed, and flags a problem in NOT REFERENCED, CONFIGURATION and
+ *   DISABLE states and on any error bit other than the two end-of-run bits
+ *   (manual EDH0206En2041 08/15, TS). */
+volatile int SMC100SetterResend = 1;
+extern "C" {epicsExportAddress(int, SMC100SetterResend);}
+volatile int SMC100StatusUpstream = 1;
+extern "C" {epicsExportAddress(int, SMC100StatusUpstream);}
+
 /** Creates a new SMC100Controller object.
   * \param[in] portName          The name of the asyn port that will be created for this driver
   * \param[in] SMC100PortName     The name of the drvAsynSerialPort that was created previously to connect to the SMC100 controller 
@@ -272,6 +289,11 @@ asynStatus SMC100Axis::setPosition(double position)
   asynStatus status;
   //static const char *functionName = "SMC100Axis::setPosition";
 
+  if (!SMC100SetterResend) {
+    asynPrint(pasynUser_, ASYN_TRACE_ERROR,
+      "SMC100Axis::setPosition: not supported by the SMC100, nothing sent (axis %d)\n", axisNo_ + 1);
+    return asynError;
+  }
   // ? not sure yet
   //sprintf(pC_->outString_, "#%02dP=%+d", axisNo_ + 1, NINT(position));
   status = pC_->writeReadController();
@@ -283,6 +305,11 @@ asynStatus SMC100Axis::setClosedLoop(bool closedLoop)
   asynStatus status;
   //static const char *functionName = "SMC100Axis::setClosedLoop";
 
+  if (!SMC100SetterResend) {
+    asynPrint(pasynUser_, ASYN_TRACE_ERROR,
+      "SMC100Axis::setClosedLoop: not implemented, nothing sent (axis %d)\n", axisNo_ + 1);
+    return asynError;
+  }
   // ? not sure yet
   //sprintf(pC_->outString_, "#%02dW=%d", axisNo_ + 1, closedLoop ? 1:0);
   status = pC_->writeReadController();
@@ -301,6 +328,48 @@ asynStatus SMC100Axis::poll(bool *moving)
   int limit;
   double position;
   asynStatus comStatus;
+  const char *reply;
+  unsigned int errorBits, state;
+
+  if (!SMC100StatusUpstream) {
+    *moving = false;
+    // Read the current motor position: "<address>TP<position>"
+    sprintf(pC_->outString_, "%1dTP", axisNo_ + 1);
+    comStatus = pC_->writeReadController();
+    if (comStatus) goto skip;
+    reply = strstr(pC_->inString_, "TP");
+    if (!reply) { comStatus = asynError; goto skip; }
+    position = (atof(reply + 2) / stepSize_);
+    setDoubleParam(pC_->motorPosition_, position);
+
+    // Read the status: "<address>TS<4 hex error digits><2 hex state digits>"
+    sprintf(pC_->outString_, "%1dTS", axisNo_ + 1);
+    comStatus = pC_->writeReadController();
+    if (comStatus) goto skip;
+    reply = strstr(pC_->inString_, "TS");
+    if (!reply || sscanf(reply + 2, "%4x%2x", &errorBits, &state) != 2) {
+      comStatus = asynError; goto skip;
+    }
+    // HOMING (1E, 1F), MOVING (28) and JOGGING (46 from READY, 47 from DISABLE) are motion
+    *moving = (state == 0x1E || state == 0x1F || state == 0x28 || state == 0x46 || state == 0x47);
+    setIntegerParam(pC_->motorStatusDone_, *moving ? 0:1);
+    setIntegerParam(pC_->motorStatusMoving_, *moving ? 1:0);
+    // bit 0 negative end of run, bit 1 positive end of run
+    setIntegerParam(pC_->motorStatusLowLimit_, (errorBits & 0x1) ? 1:0);
+    setIntegerParam(pC_->motorStatusHighLimit_, (errorBits & 0x2) ? 1:0);
+    setIntegerParam(pC_->motorStatusAtHome_, (state == 0x32) ? 1:0);
+    // referenced: every state but NOT REFERENCED (0A-11), CONFIGURATION (14) and HOMING
+    setIntegerParam(pC_->motorStatusHomed_,
+      (state >= 0x0A && state <= 0x14) || state == 0x1E || state == 0x1F ? 0:1);
+    // problem: NOT REFERENCED, CONFIGURATION, DISABLE (3C-3E), or an error bit
+    // other than the end-of-run bits (current limits, short circuit, following
+    // error, homing time-out, wrong ESP stage, DC voltage, 80 W)
+    setIntegerParam(pC_->motorStatusProblem_,
+      (state >= 0x0A && state <= 0x14) || (state >= 0x3C && state <= 0x3E) ||
+      (errorBits & ~0x3u) ? 1:0);
+    callParamCallbacks();
+    return asynSuccess;
+  }
 
   // Read the current motor position
   sprintf(pC_->outString_, "%1dTP", axisNo_ + 1);
