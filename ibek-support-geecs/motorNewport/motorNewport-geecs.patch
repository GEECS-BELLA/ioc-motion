+/** ioc-motion: read slot <slot>'s step counter (<slot>TP) into *raw; a reply
+  * that does not echo the command is an error. */
+asynStatus AG_UCController::readSlot(int slot, int *raw)
+{
+  char cmd[8];
+  char reply[40];
+  size_t nread;
+  asynStatus status;
+
+  sprintf(cmd, "%dTP", slot);
+  status = writeReadController(cmd, reply, sizeof(reply), &nread, AGILIS_TIMEOUT);
+  epicsThreadSleep(WRITE_DELAY);
+  if (status) return status;
+  if (reply[0] != '0' + slot || strncmp(&reply[1], "TP", 2) != 0 ||
+      !(reply[3] == '-' || (reply[3] >= '0' && reply[3] <= '9'))) {
+    asynPrint(pasynUserSelf, ASYN_TRACE_ERROR,
+      "AG_UCController::readSlot: %s, unexpected reply \"%s\"\n", cmd, reply);
+    return asynError;
+  }
+  *raw = atoi(&reply[3]);
+  return asynSuccess;
+}
+
+/** ioc-motion: credit a change of slot <slot>'s counter to refPair_'s axis in
+  * that slot, and keep raw as the slot's reference. */
+void AG_UCController::account(int slot, int raw)
+{
+  if (refPair_ != 0) {
+    AG_UCAxis *pAxis = getAxis((refPair_ - 1) * 2 + slot - 1);
+    if (pAxis) pAxis->pairPosition_ += raw - slotRaw_[slot];
+  }
+  slotRaw_[slot] = raw;
+}
+
+/** ioc-motion: make the selected pair the one the slots are credited to: what
+  * they counted since their last read is refPair_'s (it was idle when the CC
+  * that left it was accepted, and nothing has moved the new pair yet). */
+asynStatus AG_UCController::ensureRefs()
+{
+  asynStatus status;
+  int raw;
+
+  if (refPair_ == selected_) return asynSuccess;
+  for (int slot = 1; slot <= 2; slot++) {
+    status = readSlot(slot, &raw);
+    if (status) return status;
+    account(slot, raw);
+  }
+  refPair_ = selected_;
+  return asynSuccess;
+}
+
+/** ioc-motion: learn the selected pair after a lost or unexpected reply: CC?,
+  * or, if that goes unanswered, a slot that steps (TS not 0) means the
+  * selected pair is refPair_, the only one this driver moves. */
+asynStatus AG_UCController::resync()
+{
+  char cmd[8];
+  char reply[40];
+  size_t nread;
+  asynStatus status;
+
+  if (agNow() < resyncRetryAt_) return asynError;
+  status = writeReadController("CC?", reply, sizeof(reply), &nread, AGILIS_TIMEOUT);
+  epicsThreadSleep(WRITE_DELAY);
+  if (status == asynSuccess && reply[0] == 'C' && reply[1] == 'C' &&
+      reply[2] >= '1' && reply[2] <= '4' && reply[3] == 0) {
+    selected_ = reply[2] - '0';
+    selKnown_ = true;
+    asynPrint(pasynUserSelf, ASYN_TRACE_ERROR,
+      "AG_UCController::resync: CC? says pair %d is selected\n", selected_);
+    return asynSuccess;
+  }
+  if (refPair_ != 0) {
+    for (int slot = 1; slot <= 2; slot++) {
+      sprintf(cmd, "%dTS", slot);
+      status = writeReadController(cmd, reply, sizeof(reply), &nread, AGILIS_TIMEOUT);
+      epicsThreadSleep(WRITE_DELAY);
+      if (status == asynSuccess && reply[0] == '0' + slot && reply[1] == 'T' &&
+          reply[2] == 'S' && reply[3] >= '1' && reply[3] <= '3') {
+        selected_ = refPair_;
+        selKnown_ = true;
+        asynPrint(pasynUserSelf, ASYN_TRACE_ERROR,
+          "AG_UCController::resync: slot %d steps, so pair %d is selected\n", slot, selected_);
+        return asynSuccess;
+      }
+    }
+  }
+  asynPrint(pasynUserSelf, ASYN_TRACE_ERROR,
+    "AG_UCController::resync: the selected pair is unknown\n");
+  resyncRetryAt_ = agNow() + 1.0;
+  return asynError;
+}
+
+/** ioc-motion: select pair channelID (AG_UCChannelUpstream 0). Returns
+  * AG_SEL_OK (selected, its slot references read), AG_SEL_BUSY (CC refused
+  * with -6: the selected pair steps, the selection unchanged) or
+  * AG_SEL_PROBLEM (anything else; the selection is then unknown unless the
+  * controller refused the CC with a code that leaves it as it was). */
+int AG_UCController::selectPair(int channelID)
+{
+  char tempString[40];
+  char reply[40];
+  size_t nread;
+  int code;
+  asynStatus status;
+
+  if (!selKnown_ && resync() != asynSuccess) return AG_SEL_PROBLEM;
+  if (selected_ != channelID) {
+    sprintf(tempString, "CC%d", channelID);
+    status = writeController(tempString, AGILIS_TIMEOUT);
+    epicsThreadSleep(WRITE_DELAY);
+    if (status) {
+      selKnown_ = false;
+      return AG_SEL_PROBLEM;
+    }
+    status = writeReadController("TE", reply, sizeof(reply), &nread, AGILIS_TIMEOUT);
+    epicsThreadSleep(WRITE_DELAY);
+    if (status || strncmp(reply, "TE", 2) != 0 ||
+        !(reply[2] == '-' || (reply[2] >= '0' && reply[2] <= '9'))) {
+      asynPrint(pasynUserSelf, ASYN_TRACE_ERROR,
+        "AG_UCController::selectPair: CC%d, TE %s \"%s\": the selection is unknown\n",
+        channelID, status ? "unanswered" : "malformed", status ? "" : reply);
+      selKnown_ = false;
+      return AG_SEL_PROBLEM;
+    }
+    code = atoi(&reply[2]);
+    if (code == -6) {
+      asynPrint(pasynUserSelf, ASYN_TRACE_FLOW,
+        "AG_UCController::selectPair: CC%d refused, TE-6 (pair %d steps)\n", channelID, selected_);
+      return AG_SEL_BUSY;
+    }
+    if (code != 0) {
+      // -5: local mode (a power cycle?); others: not expected
+      asynPrint(pasynUserSelf, ASYN_TRACE_ERROR,
+        "AG_UCController::selectPair: CC%d refused, TE%d\n", channelID, code);
+      selKnown_ = false;
+      return AG_SEL_PROBLEM;
+    }
+    selected_ = channelID;
+  }
+  if (ensureRefs() != asynSuccess) return AG_SEL_PROBLEM;
+  return AG_SEL_OK;
+}
