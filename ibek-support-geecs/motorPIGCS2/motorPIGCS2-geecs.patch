+
+// ioc-motion: the #4 status word (decimal; strtol base 10 as upstream's getReferencedState)
+void PIHexapodController::parseStatusWord(const char* buf)
+{
+    m_statusWord = strtol(buf, NULL, 10);
+    m_bReferenced = (m_statusWord & 0x10000) != 0;     // bit 16: hexapod initialized
+    m_bInitialising = (m_statusWord & 0x80000) != 0;   // bit 19: initialisation in progress
+    m_bStatusWordValid = true;
+    m_bStatusWordFresh = true;
+}
+
+asynStatus PIHexapodController::readStatusWord()
+{
+    char buf[255];
+    asynStatus status = m_pInterface->sendAndReceive(char(4), buf, 99);
+    if (status != asynSuccess)
+    {
+        return status;
+    }
+    parseStatusWord(buf);
+    return asynSuccess;
+}
+
+// ioc-motion: no MOV while the controller reports not referenced (bit 16 of #4 clear); a
+// controller that does not answer #4 is not gated (upstream treats it as referenced).
+asynStatus PIHexapodController::checkReferenced(PIasynAxis* pAxis)
+{
+    asynUser* log = (pAxis && pAxis->m_pasynUser) ? pAxis->m_pasynUser : m_pInterface->m_pCurrentLogSink;
+    if (m_bHoming || m_bInitialising)
+    {
+        // the IOC's own knowledge of a reference run, whatever #5 or bit 16 say meanwhile
+        if (log)
+            asynPrint(log, ASYN_TRACE_ERROR,
+                "PIHexapodController::checkReferenced() refused: the reference run (INI) is in progress, MOV not sent\n");
+        if (pAxis && pAxis->m_pasynUser)
+            epicsSnprintf(pAxis->m_pasynUser->errorMessage, pAxis->m_pasynUser->errorMessageSize,
+                "move refused: the reference run (INI) is in progress");
+        return asynError;
+    }
+    if (!m_bCanReadStatusWithChar4 || m_bReferenced)
+    {
+        return asynSuccess;
+    }
+    if (log)
+        asynPrint(log, ASYN_TRACE_ERROR,
+            "PIHexapodController::checkReferenced() refused: the hexapod is not referenced (#4 = %ld), MOV not sent; INI first\n",
+            m_statusWord);
+    if (pAxis && pAxis->m_pasynUser)
+        epicsSnprintf(pAxis->m_pasynUser->errorMessage, pAxis->m_pasynUser->errorMessageSize,
+            "move refused: the hexapod is not referenced (INI first)");
+    return asynError;
+}
+
+asynStatus PIHexapodController::initAxesDone()
+{
+    if (!m_bAutoInitPending)
+    {
+        return asynSuccess;
+    }
+    m_bAutoInitPending = false;
+    errlogPrintf("PIHexapodController::initAxesDone() auto-init: INI\n");
+    if (startReferenceRun(NULL) != asynSuccess)
+    {
+        errlogPrintf("PIHexapodController::initAxesDone() auto-init: INI not sent\n");
+        return asynError;
+    }
+    return asynSuccess;
+}
+
+asynStatus PIHexapodController::getControllerState(int& statusWord, int& referenced, int& initialising, int& state, bool& fresh)
+{
+    if (!m_bStatusWordValid)
+    {
+        return asynError;
+    }
+    fresh = m_bStatusWordFresh;
+    statusWord = int(m_statusWord);
+    referenced = m_bReferenced ? 1 : 0;
+    initialising = m_bInitialising ? 1 : 0;
+    if (m_bHoming || m_bInitialising)
+        state = 1;   // homing: the reference run moves the platform
+    else if (!m_bReferenced)
+        state = 0;   // not referenced
+    else if (m_bAnyAxisMoving)
+        state = 2;   // moving
+    else
+        state = 3;   // ready
+    return asynSuccess;
 }
 
