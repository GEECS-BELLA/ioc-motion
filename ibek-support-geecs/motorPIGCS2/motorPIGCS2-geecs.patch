diff --git a/pigcs2App/Db/PIHexapodCtrl.db b/pigcs2App/Db/PIHexapodCtrl.db
new file mode 100644
index 0000000..e87aadb
--- /dev/null
+++ b/pigcs2App/Db/PIHexapodCtrl.db
@@ -0,0 +1,119 @@
+# ioc-motion: the per-controller records of a PI hexapod that an IOC which sets
+# positions and starts the reference run needs: DEFER (the motor record's
+# deferred moves: every axis's VAL written while ON, then OFF, is one six-axis
+# MOV), the controller's #4 status word and what it says (REFERENCED,
+# INITIALISING, the four-state STATE), INIT (the reference run, INI, every
+# axis; refused, nothing sent, when the driver's PIHexapodHomeAllowed is 0 or
+# the platform moves: the IOC log says so and STATE stays as it was, while the
+# bo's write alarm lasts only until HIGH resets it), the pivot point as read
+# from the controller at init
+# (SPI? RST: X Y Z here are PI's R S T) and the driver's last GCS error. The
+# pivot setters and CLEAR_ERR of upstream's PI_SupportCtrl.db /
+# PI_SupportError.db are left out on purpose.
+#
+# The GEECS device's two state variables map one to one: hexinit (Not
+# referenced / Referenced; its set is INI) = REFERENCED + INIT, status (Not
+# referenced / Homing / Moving / Ready) = STATE.
+record(bo, "$(P)DEFER") {
+  field(DTYP, "asynInt32")
+  field(OUT, "@asynMask($(PORT),0,0)MOTOR_DEFER_MOVES")
+  field(SCAN, "Passive")
+  field(ZNAM, "OFF")
+  field(ONAM, "ON")
+  field(VAL, "0")
+}
+
+record(ai, "$(P)RBPIVOT_X")
+{
+	field(DESC, "Pivot R (SPI? at init)")
+	field(PINI, "1")
+	field(DTYP, "asynFloat64")
+	field(INP, "@asyn($(PORT),0,0)PI_SUP_RBPIVOT_X")
+	field(PREC, "3")
+	field(EGU, "mm")
+	field(SCAN, "I/O Intr")
+}
+
+record(ai, "$(P)RBPIVOT_Y")
+{
+	field(DESC, "Pivot S (SPI? at init)")
+	field(PINI, "1")
+	field(DTYP, "asynFloat64")
+	field(INP, "@asyn($(PORT),0,0)PI_SUP_RBPIVOT_Y")
+	field(PREC, "3")
+	field(EGU, "mm")
+	field(SCAN, "I/O Intr")
+}
+
+record(ai, "$(P)RBPIVOT_Z")
+{
+	field(DESC, "Pivot T (SPI? at init)")
+	field(PINI, "1")
+	field(DTYP, "asynFloat64")
+	field(INP, "@asyn($(PORT),0,0)PI_SUP_RBPIVOT_Z")
+	field(PREC, "3")
+	field(EGU, "mm")
+	field(SCAN, "I/O Intr")
+}
+
+record(longin, "$(P)STATUS_WORD")
+{
+	field(DESC, "#4 status word, decimal")
+	field(DTYP, "asynInt32")
+	field(INP, "@asyn($(PORT),0,0)PI_HEX_STATUS_WORD")
+	field(SCAN, "I/O Intr")
+}
+
+record(bi, "$(P)REFERENCED")
+{
+	field(DESC, "#4 bit 16 (hexinit)")
+	field(DTYP, "asynInt32")
+	field(INP, "@asyn($(PORT),0,0)PI_HEX_REFERENCED")
+	field(ZNAM, "Not referenced")
+	field(ONAM, "Referenced")
+	field(SCAN, "I/O Intr")
+}
+
+record(bi, "$(P)INITIALISING")
+{
+	field(DESC, "#4 bit 19")
+	field(DTYP, "asynInt32")
+	field(INP, "@asyn($(PORT),0,0)PI_HEX_INITIALISING")
+	field(ZNAM, "No")
+	field(ONAM, "Initialising")
+	field(SCAN, "I/O Intr")
+}
+
+record(mbbi, "$(P)STATE")
+{
+	field(DESC, "Controller state (status)")
+	field(DTYP, "asynInt32")
+	field(INP, "@asyn($(PORT),0,0)PI_HEX_STATE")
+	field(ZRVL, "0")
+	field(ZRST, "Not referenced")
+	field(ONVL, "1")
+	field(ONST, "Homing")
+	field(TWVL, "2")
+	field(TWST, "Moving")
+	field(THVL, "3")
+	field(THST, "Ready")
+	field(SCAN, "I/O Intr")
+}
+
+record(bo, "$(P)INIT")
+{
+	field(DESC, "Reference run: INI, every axis")
+	field(DTYP, "asynInt32")
+	field(OUT, "@asyn($(PORT),0,0)PI_HEX_INIT")
+	field(ZNAM, "")
+	field(ONAM, "Init")
+	field(HIGH, "1")
+}
+
+record(longin, "$(P)LAST_ERR")
+{
+	field(DESC, "Last GCS error the driver saw")
+	field(DTYP, "asynInt32")
+	field(INP, "@asyn($(PORT),0,0)PI_SUP_LAST_ERR")
+	field(SCAN, "I/O Intr")
+}
diff --git a/pigcs2App/Db/PIHexapodMotor.db b/pigcs2App/Db/PIHexapodMotor.db
new file mode 100644
index 0000000..42bbfca
--- /dev/null
+++ b/pigcs2App/Db/PIHexapodMotor.db
@@ -0,0 +1,34 @@
+# ioc-motion: one axis of a PI hexapod as a motor record on motorPIGCS2's
+# PIasynController (DTYP asynMotor), and nothing else: no auxiliary records with
+# links into the driver. RSTM defaults to Never, so the record never asks the
+# driver to redefine the position at init (devMotorAsyn's init_controller does
+# for RSTM Always, or NearZero/Conditional with a non-zero DVAL after an autosave
+# restore; the hexapod's POS redefine is not this IOC's to send). RTRY 0: the
+# controller positions itself, the record does not retry. DISP 1 refuses every
+# put to the record's fields (dbPutField: CA and dbpf) without stopping the
+# driver's status callbacks, so readbacks stay live. MRES is the driver's fixed
+# counting unit (1e-4 of the axis's unit: mm for X Y Z, degrees for U V W).
+record(motor, "$(P)$(M)")
+{
+	field(DESC, "$(DESC)")
+	field(DTYP, "asynMotor")
+	field(OUT,  "@asyn($(PORT),$(ADDR))")
+	field(DIR,  "$(DIR)")
+	field(VELO, "$(VELO)")
+	field(VBAS, "$(VBAS)")
+	field(VMAX, "$(VMAX=0)")
+	field(ACCL, "$(ACCL)")
+	field(BDST, "$(BDST)")
+	field(BVEL, "$(BVEL)")
+	field(BACC, "$(BACC)")
+	field(MRES, "$(MRES)")
+	field(PREC, "$(PREC)")
+	field(EGU,  "$(EGU)")
+	field(DHLM, "$(DHLM)")
+	field(DLLM, "$(DLLM)")
+	field(RDBD, "$(RDBD=0)")
+	field(RTRY, "$(RTRY=0)")
+	field(RSTM, "$(RSTM=Never)")
+	field(TWV,  "$(TWV=0.01)")
+	field(DISP, "$(DISP=0)")
+}
