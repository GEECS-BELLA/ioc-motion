+    {
+        asynPrint(m_pInterface->m_pCurrentLogSink, ASYN_TRACE_ERROR,
+                "PIHexapodController::checkMovePossible() refused: VMO%s -> %s (target outside the workspace)\n", szTargets, buf);
+        if (NULL != pAxis && NULL != pAxis->m_pasynUser)
+        {
+            epicsSnprintf(pAxis->m_pasynUser->errorMessage, pAxis->m_pasynUser->errorMessageSize,
+                "move refused: VMO%s -> %s (target outside the hexapod workspace)", szTargets, buf);
+        }
+        return asynError;
+    }
+    return asynSuccess;
 }
 
