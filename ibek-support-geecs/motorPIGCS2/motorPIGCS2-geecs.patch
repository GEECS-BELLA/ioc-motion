+}
+
+asynStatus PIHexapodController::checkMovePossible(PIasynAxis* pAxis, const char* szTargets)
+{
+    if (!PIHexapodVmoCheck)
+    {
+        return asynSuccess;
+    }
+    char cmd[1100];
+    char buf[255];
+    epicsSnprintf(cmd, sizeof(cmd), "VMO%s", szTargets);
+    asynStatus status = m_pInterface->sendAndReceive(cmd, buf, 99);
+    if (asynSuccess != status)
+    {
+        asynPrint(m_pInterface->m_pCurrentLogSink, ASYN_TRACE_ERROR,
+                "PIHexapodController::checkMovePossible() VMO failed, status %d\n", status);
+        return status;
+    }
+    if (atoi(buf) != 0)
+    {
+        asynPrint(m_pInterface->m_pCurrentLogSink, ASYN_TRACE_ERROR,
+                "PIHexapodController::checkMovePossible() refused: VMO%s -> %s (target outside the workspace)\n", szTargets, buf);
+        if (NULL != pAxis && NULL != pAxis->m_pasynUser)
+        {
+            epicsSnprintf(pAxis->m_pasynUser->errorMessage, pAxis->m_pasynUser->errorMessageSize,
+                "move refused: VMO%s -> %s (target outside the hexapod workspace)", szTargets, buf);
+        }
+        return asynError;
+    }
+    return asynSuccess;
 }
 
