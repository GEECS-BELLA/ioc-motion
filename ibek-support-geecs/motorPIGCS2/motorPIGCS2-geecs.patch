+#include <errlog.h>
+#include <epicsExport.h>
+
+// ioc-motion (GEECS-BELLA): eight iocsh variables, each defaulting to upstream's
+// behaviour; `variable()` lines in PI_GCS2Support.dbd make them settable from
+// st.cmd before the controller is created.
+//   PIHexapodInitServo   1: SVO <axis> 1 per axis at init (a write at every IOC start);
+//                        0: SVO? <axis> is read instead and reported.
+//   PIHexapodHomeAllowed 1: the INIT record and the record's HOMF/HOMR send INI (the reference
+//                        run, every axis, no axis identifier); 0: refused with an error, nothing sent.
+//   PIHexapodVmoCheck    0: MOV straight away; 1: VMO with the same targets first,
+//                        and a "1" (not possible) refuses the move, nothing sent.
+//   PIHexapodSendVel     1: VEL <axis> <v> before every move (the record's VELO);
+//                        0: nothing, the platform's velocity stays the controller's.
+//   PIHexapodPosWithChar3 1: probe #3 at init and read positions with it while moving;
+//                        0: never send #3; positions while moving come from POS? <axis>.
+//                        (PIInterface::sendAndReceive(char) re-sends the byte for every
+//                        continuation line of a multi-line reply, so a six-line #3 reply
+//                        costs ~26 round trips under the port lock and only the first
+//                        axis parses.)
+//   PIHexapodJogAllowed  1: the record's JOGF/JOGR send MOV <axis> <travel limit>;
+//                        0: refused with an error, nothing sent.
+//   PIHexapodSetPosAllowed 1: the record's SET redefines the position (RON 0, POS, RON 1);
+//                        0: refused with an error, nothing sent.
+//   PIHexapodAutoInit    0: nothing (upstream has no such step);
+//                        1: when #4 reports not referenced (bit 16 clear) at init, send INI once
+//                        the axes have asked their init queries (the LabVIEW device's start-up
+//                        behaviour); needs PIHexapodHomeAllowed 1.
+int PIHexapodInitServo = 1;
+int PIHexapodHomeAllowed = 1;
+int PIHexapodVmoCheck = 0;
+int PIHexapodSendVel = 1;
+int PIHexapodPosWithChar3 = 1;
+int PIHexapodJogAllowed = 1;
+int PIHexapodSetPosAllowed = 1;
+int PIHexapodAutoInit = 0;
+extern "C" {
+epicsExportAddress(int, PIHexapodInitServo);
+epicsExportAddress(int, PIHexapodHomeAllowed);
+epicsExportAddress(int, PIHexapodVmoCheck);
+epicsExportAddress(int, PIHexapodSendVel);
+epicsExportAddress(int, PIHexapodPosWithChar3);
+epicsExportAddress(int, PIHexapodJogAllowed);
+epicsExportAddress(int, PIHexapodSetPosAllowed);
+epicsExportAddress(int, PIHexapodAutoInit);
+}
 
